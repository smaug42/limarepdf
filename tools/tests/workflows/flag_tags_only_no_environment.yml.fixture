# Tags only, so no pull request reaches it; still no environment, so the secrets aren't protected.
on:
  push:
    tags: ["v*"]
jobs:
  release:
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    steps:
      - run: gpg --batch --passphrase "${{ secrets.GPG_PASSPHRASE }}" --detach-sign x
