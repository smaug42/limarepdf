# A YAML comment naming ${{ secrets.GPG_SIGNING_KEY }} isn't read by Actions.
on:
  pull_request:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      # Not ${{ secrets.GPG_PASSPHRASE }} here.
      - run: gh release list  # secrets.GPG_SIGNING_KEY isn't used
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
