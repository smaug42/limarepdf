on:
  pull_request:
  release:
    types: [published]
jobs:
  sign:
    if: ${{ (github.event_name == 'release' || startsWith(github.ref, 'refs/tags/v')) && !cancelled() }}
    runs-on: ubuntu-latest
    environment: 'release-signing'
    steps:
      - run: echo "${{ secrets.GPG_SIGNING_KEY }}" | gpg --batch --import
